#!/usr/bin/env bash
# post-commit hook: notify when docs-seo agent evaluation may be needed.
# Enable with: git config core.hooksPath .githooks
#
# This hook detects changes to trigger files and:
#   1. Prints a structured reminder to run the @docs-seo agent
#   2. Runs the automated consistency checker (check_docs_seo.py) non-fatally
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Step 1: detect trigger files and print reminder
bash "$REPO_ROOT/scripts/docs-seo-trigger.sh"

# Step 2: run automated consistency check (non-fatal — docs may be fine)
if command -v python3 &>/dev/null && [ -f "$REPO_ROOT/scripts/check_docs_seo.py" ]; then
    python3 "$REPO_ROOT/scripts/check_docs_seo.py" || true
fi
